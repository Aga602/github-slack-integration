# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Go build output
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go test binary
*.test

# Go coverage files
*.out
coverage.out
cover.out
coverage.html

# Go vendor directory (if not using modules)
# vendor/

# Go workspace files
go.work
go.work.sum

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/

# JetBrains IDE
.idea/
*.iml

# VSCode
.vscode/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Built / generated files
deploy/_output

# Env files
.env
.env.local
.env.*.local

# Temporary files
tmp/
tmp/*

# Security
*.pem
*.key

# Log storage
storage/log/*

# IDE/Editor specific
*.swp
*.swo
*~

# Debugging
__debug_bin*

# Task files
.TODO
.qodo
